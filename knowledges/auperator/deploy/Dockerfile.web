# Auperator Web UI Dockerfile
# 基于 Next.js 的前端应用 (使用 pnpm)

# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:20-alpine AS deps

# 设置标签
LABEL maintainer="Auperator Team"
LABEL description="Auperator Web UI - Next.js Chat Interface"

# 设置工作目录
WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm

# 复制 package 文件
COPY src/web/package*.json ./
COPY src/web/pnpm-lock.yaml* ./

# 安装依赖
RUN pnpm install --frozen-lockfile

# ============================================
# Stage 2: Builder
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# 安装 pnpm（确保有完整的 pnpm 环境）
RUN npm install -g pnpm

# 从 deps 阶段复制 node_modules
COPY --from=deps /app/node_modules ./node_modules
COPY src/web . .

# 声明构建参数
ARG NEXT_PUBLIC_API_BASE_URL=/api

# 设置构建时环境变量
# NEXT_PUBLIC_ 前缀的变量会被嵌入到客户端代码中
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

# 构建应用
RUN pnpm build

# ============================================
# Stage 3: Runner
# ============================================
FROM node:20-alpine AS runner

WORKDIR /app

# 设置环境变量
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

# 创建非 root 用户
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# 复制必要文件
COPY --from=builder /app/public ./public
COPY --from=builder /app/package*.json ./

# 复制构建产物
# 只复制 .next/static 和 .next/standalone，这是生产环境运行所需的
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# 切换到非 root 用户
USER nextjs

# 暴露端口
EXPOSE 3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# 设置入口点
ENTRYPOINT ["node", "server.js"]
