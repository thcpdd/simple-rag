# ============================================
# SimpleRAG API — Dockerfile
# 多阶段构建 (Builder → Runtime)
# ============================================

# ============================================
# Stage 1: Builder
# ============================================
FROM python:3.11-slim AS builder

WORKDIR /app

RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl gcc g++ && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://uv.agentsmirror.com/install-cn.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

COPY backend/pyproject.toml backend/uv.lock backend/README.md ./backend/

COPY backend/app ./backend/app
COPY backend/main.py ./backend/

RUN uv sync --frozen --directory backend

# ============================================
# Stage 2: Runtime
# ============================================
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/backend/.venv/bin:$PATH"

RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app

EXPOSE 7500

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:7500/health || exit 1

CMD ["uvicorn", "main:app", "--app-dir", "/app/backend", "--host", "0.0.0.0", "--port", "7500"]
